# Copy to .env and fill in. PuffinParse reads these from the environment.
REDUCTO_API_KEY=
EXTEND_API_KEY=
LLAMA_API_KEY=            # LlamaCloud / LlamaParse key (starts with llx-)
# Optional overrides
# PUFFINPARSE_LOG=info
# Document URLs that PuffinParse downloads itself (providers without URL input) may only reach
# public addresses. Set to 1 only in a trusted setup that needs private/LAN addresses.
# PUFFINPARSE_ALLOW_PRIVATE_URLS=0
# PUFFINPARSE_MAX_DOWNLOAD_MB=50
# REDUCTO_BASE_URL=https://platform.reducto.ai
# EXTEND_BASE_URL=https://api.extend.ai
# LLAMA_BASE_URL=https://api.cloud.llamaindex.ai

# ---- additional providers (all optional; set only the ones you use) ----
MISTRAL_API_KEY=          # Mistral La Plateforme key (Document AI / OCR)
AZURE_DOCUMENT_INTELLIGENCE_KEY=       # Azure AI Document Intelligence resource key
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=  # per-resource, e.g. https://my-di.cognitiveservices.azure.com
AWS_ACCESS_KEY_ID=        # AWS Textract (a key pair, not a single token)
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=      # only for STS / assumed-role credentials
# AWS_REGION=us-east-1
GEMINI_API_KEY=           # Google AI Studio key (starts with AIza), for gemini/* models
OPENAI_API_KEY=           # OpenAI Responses API key (starts with sk-)
ANTHROPIC_API_KEY=        # Anthropic Messages API key (starts with sk-ant-)
MATHPIX_APP_ID=           # Mathpix needs BOTH values
MATHPIX_APP_KEY=
DATALAB_API_KEY=          # Datalab / Marker
UNSTRUCTURED_API_KEY=     # Unstructured Partition endpoint
UPSTAGE_API_KEY=          # Upstage Document Parse
LANDINGAI_API_KEY=        # Landing AI ADE
GOOGLE_DOCUMENTAI_ACCESS_TOKEN=   # OAuth2 token, e.g. $(gcloud auth print-access-token); expires hourly
GOOGLE_DOCUMENTAI_PROJECT=        # GCP project id
GOOGLE_DOCUMENTAI_LOCATION=us     # us | eu
GOOGLE_DOCUMENTAI_PROCESSOR_ID=   # processor id created in that project/location
OPEN_DOC_ROUTER_API_KEY=  # OpenDocRouter (opendocrouter.ai), for opendocrouter/<vendor>/<model>
# OPEN_DOC_ROUTER_BASE_URL=https://www.opendocrouter.ai

# ---- local / self-hosted engines (no API key, $0 per page) ----
# TESSERACT_CMD=tesseract                 # path to the tesseract binary (apt install tesseract-ocr)
# PDFTOPPM_CMD=pdftoppm                   # poppler's rasteriser, used for PDFs (apt install poppler-utils)
# DOCLING_BASE_URL=http://localhost:5001  # your docling-serve
# DOCLING_API_KEY=                        # only if docling-serve runs with DOCLING_SERVE_API_KEY
# PADDLEOCR_BASE_URL=http://localhost:8080        # PaddleOCR/PaddleX serving, OCR pipeline (/ocr)
# PADDLEOCR_PARSE_BASE_URL=http://localhost:8081  # PP-StructureV3 serving (/layout-parsing); defaults to PADDLEOCR_BASE_URL
# PADDLEOCR_VL_BASE_URL=http://localhost:8080     # PaddleOCR-VL pipeline serving (paddleocr/vl); defaults to PADDLEOCR_BASE_URL
# VLLM_BASE_URL=http://localhost:8000             # your `vllm serve` for vllm/* presets (with or without /v1)
# VLLM_API_KEY=                                   # only if vllm serve runs with --api-key
# VLLM_SERVED_MODEL=                              # only if --served-model-name differs from the preset's
# Base URL overrides: <PROVIDER>_BASE_URL, e.g. MISTRAL_BASE_URL, OPENAI_BASE_URL, TEXTRACT_BASE_URL
