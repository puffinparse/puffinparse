{
  "name": "puffinparse",
  "version": "0.1.6",
  "description": "One API for every OCR / document-parsing provider (Reducto, Extend, LlamaParse, ...). Node.js bindings to the PuffinParse Rust core.",
  "keywords": ["ocr", "document-parsing", "pdf", "reducto", "llamaparse", "extend", "napi-rs"],
  "license": "MIT",
  "author": "PuffinParse contributors",
  "homepage": "https://puffinparse.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajinkyashejul/puffinparse.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/ajinkyashejul/puffinparse/issues"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "native.js",
    "native.d.ts",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "engines": {
    "node": ">=18"
  },
  "napi": {
    "binaryName": "puffinparse",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --manifest-path ../crates/puffinparse-node/Cargo.toml --package-json-path package.json --output-dir . --platform --release --js native.js --dts native.d.ts",
    "build:debug": "napi build --manifest-path ../crates/puffinparse-node/Cargo.toml --package-json-path package.json --output-dir . --platform --js native.js --dts native.d.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
